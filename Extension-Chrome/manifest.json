{
  "manifest_version": 3,
  "name": "Key-sound-control | Audio Router",
  "version": "1.0.0",
  "description": "Enruta el audio de pestañas individuales (YouTube, Twitch, Spotify, etc.) a diferentes salidas de sonido de forma independiente.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Abrir selector de salida de audio para la pestaña actual"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
